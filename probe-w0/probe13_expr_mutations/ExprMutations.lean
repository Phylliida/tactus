-- W6e expression-level mutation-kill suite (bootstrap-24; b77 arm kills
-- added), GENERATED by gen.py from the LIVE fixture certs. For each class:
-- the unperturbed deep bridge closes (=1); a single structural mutation
-- (GOAL-side coercion drop, or SST-side mark/arm perturbation) must FLIP
-- the verdict to 0 (proved positively by decide), because ref_wp
-- INDEPENDENTLY re-derives the correct structure. If any mutation still
-- equalled 1, its `= 0` example would error.

-- bootstrap-79: the leaf-normalized comparison, retained for
-- reference — count_to_len's Loop classes used it while the
-- subject was A7-class. A7 landed (bootstrap-80): the Loop
-- classes now run the FULL deep bridge (strips unused).
noncomputable def strip : lib.GoalData → lib.GoalData
  | .All x t b => .All x t ⟨strip b.deref⟩
  | .Imp h b => .Imp h ⟨strip b.deref⟩
  | .Let x v b => .Let x v ⟨strip b.deref⟩
  | .LeafE _ => .LeafE (lib.ExprData.Atom 0)
  | .Leaf _ => .Leaf 0
noncomputable def strips : lib.GoalList → lib.GoalList
  | .Cons g t => .Cons ⟨strip g.deref⟩ ⟨(strips t.deref)⟩
  | .Nil => .Nil

