-- Probe-local per-goal accessor (Nat-structural; Box via .deref).
@[reducible] noncomputable def gl_nth (l : lib.GoalList) : Nat → Option lib.GoalData :=
  fun n => match n, l with
  | 0, lib.GoalList.Cons g _ => some g.deref
