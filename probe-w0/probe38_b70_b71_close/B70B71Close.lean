  | _, lib.GoalList.Nil => none

@[reducible] noncomputable def gl_nth_eq (a b : lib.GoalList) (n : Nat) : Nat :=
  match gl_nth a n, gl_nth b n with
  | some x, some y => lib.goal_eq x y
  | _, _ => 2

